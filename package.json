{
  "name": "terranova",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Administracion de Lotes - monorepo",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @terranova/db run generate",
    "db:migrate": "pnpm --filter @terranova/db run migrate",
    "db:deploy": "pnpm --filter @terranova/db run deploy",
    "db:seed": "pnpm --filter @terranova/db run seed",
    "db:arranque": "pnpm --filter @terranova/db run arranque",
    "db:studio": "pnpm --filter @terranova/db run studio",
    "db:reset": "pnpm --filter @terranova/db run reset",
    "up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "logs": "docker compose -f infra/docker-compose.yml --env-file .env logs -f",
    "migrar:legacy": "pnpm --filter @terranova/migracion-localstorage run start",
    "verificar:rutas": "bash infra/scripts/verificar-rutas.sh",
    "up:completo": "docker compose -f infra/docker-compose.yml --env-file .env --profile completo up -d --build",
    "ps": "docker compose -f infra/docker-compose.yml --env-file .env ps"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "catalog:",
    "prettier": "^3.6.2"
  }
}
