# ---------------------------------------------------------------
# Frontend (Next.js)  ·  cp apps/web/.env.example apps/web/.env.local
# ---------------------------------------------------------------
# Direccion interna de la API. No se expone al navegador: todas las
# peticiones del cliente pasan por /api/* del propio Next (ver el proxy en
# src/app/api/[...ruta]/route.ts).
API_URL=http://localhost:3101

# URL publica del propio frontend. La usan los componentes de servidor,
# que necesitan una direccion absoluta para llamarse a si mismos.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
