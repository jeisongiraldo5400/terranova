    "@nestjs/swagger": "^11.2.0",
    "@terranova/db": "workspace:*",
    "@terranova/shared": "workspace:*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
