# ---------------------------------------------------------------
# Base de datos (Prisma)  ·  cp packages/db/.env.example packages/db/.env
# ---------------------------------------------------------------
# Lo usan las migraciones (pnpm db:*), el seed y el importador de
# tools/migracion-localstorage. Debe ser la misma que apps/api/.env.
# Vea alli las opciones local y gestionada, y por que timezone=UTC es
# obligatorio.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:PUERTO/terranova?schema=public&sslmode=require&options=-c%20timezone%3DUTC"

# Usuario administrador inicial (pnpm db:seed y pnpm db:arranque)
SEED_ADMIN_EMAIL=admin@terranova.co
SEED_ADMIN_PASSWORD=Cambiar.2026
