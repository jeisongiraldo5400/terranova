# ---------------------------------------------------------------
# Docker Compose y scripts de infra  ·  cp infra/.env.example infra/.env
# ---------------------------------------------------------------
# Compose lee este archivo por si solo porque esta junto a
# docker-compose.yml. Solo hace falta para el PostgreSQL local; con una
# base gestionada puede omitirse.
#
# Los contenedores de la API y la web (pnpm up:completo) toman el resto
# de su configuracion de apps/api/.env y apps/web/.env.local.
POSTGRES_USER=terranova
POSTGRES_PASSWORD=terranova_local
POSTGRES_DB=terranova
POSTGRES_PORT=5432

# Dias que infra/scripts/backup.sh conserva los respaldos
BACKUP_RETENER_DIAS=30
