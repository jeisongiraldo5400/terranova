# ---------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------
# timezone=UTC es obligatorio: las fechas de negocio son columnas DATE y
# la zona de la sesion decide como se convierte un timestamp a DATE. Sin
# esto, una venta del 1 de septiembre se guarda el 31 de agosto.

# --- Opcion A: PostgreSQL local en Docker (desarrollo) ---
# POSTGRES_USER=terranova
# POSTGRES_PASSWORD=cambiar_en_produccion
# POSTGRES_DB=terranova
# DATABASE_URL="postgresql://terranova:cambiar_en_produccion@localhost:5432/terranova?schema=public&options=-c%20timezone%3DUTC"

# --- Opcion B: PostgreSQL gestionado (Railway, Neon, RDS...) ---
# sslmode=require: el proveedor exige TLS y suele presentar un certificado
# autofirmado. Prisma lo interpreta como libpq -- cifrar sin verificar la
# CA -- y conecta. Cuidado: node-pg trata 'require' como verificacion
# completa y lo rechaza, de modo que los scripts que usen pg directamente
# deben pasar ssl: { rejectUnauthorized: false } de forma explicita.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:PUERTO/terranova?schema=public&sslmode=require&options=-c%20timezone%3DUTC"

# ---------------------------------------------------------------
# Pruebas de integracion
# ---------------------------------------------------------------
# Las pruebas e2e CREAN Y DESTRUYEN la base `terranova_test` en cada
# ejecucion, de modo que no usan DATABASE_URL: esa puede apuntar a un
# servidor gestionado compartido. Solo aceptan un destino local y se
# niegan a correr contra cualquier otro anfitrion.
# Si se omite, se asume el PostgreSQL de `pnpm up`.
# TEST_DATABASE_URL="postgresql://terranova:terranova_local@localhost:5432/postgres"

# ---------------------------------------------------------------
# API
# ---------------------------------------------------------------
# 3101 y 3100 en lugar de 3001/3000: son los puertos libres en la maquina
# de desarrollo actual. Ajustelos si en la suya no hay conflicto.
API_PORT=3101
NODE_ENV=development
CORS_ORIGIN=http://localhost:3100

# JWT: generar con `openssl rand -base64 48`
JWT_ACCESS_SECRET=cambiar_secreto_access
JWT_REFRESH_SECRET=cambiar_secreto_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Usuario administrador inicial (solo para el seed)
SEED_ADMIN_EMAIL=admin@terranova.co
SEED_ADMIN_PASSWORD=Cambiar.2026

# ---------------------------------------------------------------
# Almacenamiento de contratos PDF
# ---------------------------------------------------------------
CONTRATOS_DIR=./contratos

# ---------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3101
